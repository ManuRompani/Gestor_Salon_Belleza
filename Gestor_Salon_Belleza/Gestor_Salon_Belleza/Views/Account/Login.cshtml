@using Gestor_Salon_Belleza.Utils.Enumerables
@model Gestor_Salon_Belleza.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null; // Quita el menú y footer por defecto de ASP.NET
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Glow & Style</title>

    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <a asp-controller="Home" asp-action="Index" div class="auth-logo">Glow & Style</a>

            <div id="login-section">
                <p class="auth-subtitle">EXPERIENCIA PREMIUM</p>
                <h2 class="auth-title">Bienvenido de nuevo</h2>

                @if (TempData["Exito"] != null)
                {
                    <div class="auth-success-alert">@TempData["Exito"]</div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="auth-error-alert">@TempData["Error"]</div>
                }

                <form asp-action="LoginAuthenticate" asp-controller="Account" method="post" class="auth-form">
                    <input type="hidden" name="returnUrl" value="@Context.Request.Query["ReturnUrl"]" />
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="auth-error-alert"></div>
                    }

                    <div class="form-group">
                        <label asp-for="Email">Correo Electrónico</label>
                        <input asp-for="Email" class="form-control" placeholder="ejemplo@correo.com" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-primary-custom">Iniciar Sesión</button>
                </form>

                <div class="auth-divider">
                    <span>o continúa con</span>
                </div>


          
                <form asp-action="ExternalLogin" asp-controller="Account" asp-route-provider="Google" asp-route-tipoUsuario=@EnumRoles.Cliente method="post">
                    <input type="hidden" name="returnUrl" value="@Context.Request.Query["ReturnUrl"]" />
                    <button type="submit" class="btn-google">
                        <svg viewBox="0 0 24 24" width="18" height="18" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05" />
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335" />
                        </svg>
                        Google
                    </button>
                </form>

                

                <p class="auth-switch">
                    ¿No tienes una cuenta? <a asp-controller ="Account" asp-action="Register">Regístrate</a>
                </p>
            </div>
        </div>
    </div>

</body>
</html>
