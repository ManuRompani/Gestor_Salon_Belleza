@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperar contraseña - Glow & Style</title>

    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <a asp-controller="Home" asp-action="Index" class="auth-logo">Glow & Style</a>

            <div id="recuperar-section">
                <p class="auth-subtitle">RECUPERACIÓN DE CUENTA</p>
                <h2 class="auth-title">Recuperar contraseña</h2>

                @if (TempData["Exito"] != null)
                {
                    <div class="auth-success-alert">@TempData["Exito"]</div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="auth-error-alert">@TempData["Error"]</div>
                }

                <form asp-action="RecuperarPassword" asp-controller="Account" method="post" class="auth-form">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label for="email">Correo Electrónico</label>
                        <input id="email"
                               name="email"
                               type="email"
                               class="form-control"
                               placeholder="ejemplo@correo.com"
                               required />
                    </div>

                    <button type="submit" class="btn-primary-custom">
                        Enviar contraseña temporal
                    </button>
                </form>

                <p class="auth-switch">
                    <a asp-controller="Account" asp-action="Login">
                        Volver al inicio de sesión
                    </a>
                </p>
            </div>
        </div>
    </div>
</body>
</html>