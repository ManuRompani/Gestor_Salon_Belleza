@{
    ViewData["Title"] = "Panel de Control - Administrador";
}

@section DashboardAdmin {
    <link rel="stylesheet" href="~/css/admin/dashboard-admin.css" />
}

<div class="dash-wrap">
    <div class="dash-header">
        <h1>Panel de control</h1>
        <p>Gestión interna · Atelier de Belleza</p>
    </div>

</div>

<div class="flex-dashboard">

    <div class="dashboard-card">
        <div>
            <h2>Servicios</h2>
            <p class="dash-desc">Administrá altas, bajas lógicas, modificaciones de precios y tiempos estimados de los tratamientos del salón.</p>
        </div>

        <div>
            <a asp-controller="Admin"
               asp-action="DashboardServices"
               class="btn btn-primary">Gestionar servicios</a>
        </div>


    </div>

    <div class="dashboard-card">
        <div>
            <h2>Profesionales</h2>
            <p class="dash-desc">Administrá el equipo de estilistas, asigná sus especialidades de servicio y controlá sus horarios de atención.</p>
        </div>

        <div>
            <a asp-controller="Profesional" asp-action="AdminIndex" class="btn btn-primary">Gestionar profesionales</a>
        </div>


    </div>



</div>

