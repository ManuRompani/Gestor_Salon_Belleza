@{
    ViewData["Title"] = "Panel de Control - Administrador";
}

<div class="container mt-4">
    <div class="d-flex align-items-center p-3 my-3 text-white bg-dark rounded shadow-sm">
        <div class="lh-1">
            <h1 class="h3 mb-0 text-white lh-1"><i class="bi bi-shield-lock-fill"></i> Panel de Control</h1>
            <small class="text-muted">Gestión interna del Salón de Belleza</small>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body p-4 border-start border-primary border-4 rounded-end">
                    <div class="d-flex align-items-center mb-3">
                        <div class="p-3 bg-primary bg-opacity-10 text-primary rounded me-3">
                            <i class="bi bi-scissors fs-3"></i>
                        </div>
                        <div>
                            <h4 class="card-title fw-bold text-dark mb-0">Servicios</h4>
                            <small class="text-muted">Configuración de catálogo</small>
                        </div>
                    </div>
                    <p class="card-text text-secondary">Administrá las altas, bajas lógicas, modificaciones de precios y tiempos estimados de los tratamientos del salón.</p>
                    <div class="mt-4">
                        <a asp-controller="Admin" asp-action="DashboardServices" class="btn btn-primary w-100 py-2">
                            Gestionar Servicios
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body p-4 border-start border-success border-4 rounded-end">
                    <div class="d-flex align-items-center mb-3">
                        <div class="p-3 bg-success bg-opacity-10 text-success rounded me-3">
                            <i class="bi bi-person-badge-fill fs-3"></i>
                        </div>
                        <div>
                            <h4 class="card-title fw-bold text-dark mb-0">Profesionales</h4>
                            <small class="text-muted">Gestión del Staff</small>
                        </div>
                    </div>
                    <p class="card-text text-secondary">Administrá el equipo de estilistas, asigná sus especialidades de servicio y controlá sus horarios de atención.</p>
                    <div class="mt-4">
                        <a asp-controller="Profesionales" asp-action="Index" class="btn btn-success w-100 py-2">
                            Gestionar Profesionales
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>