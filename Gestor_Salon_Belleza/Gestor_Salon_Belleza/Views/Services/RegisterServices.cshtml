@model IEnumerable<Gestor_Salon_Belleza.Models.Servicio>

@{
    ViewData["Title"] = "Glow & Style | ADMIN: Registrar Servicios";
}


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrar Servicio - Gestor de Belleza</title>
    
</head>
<body>

    <main class="container">
        <section class="form-card">
            <header class="form-header">
                <h2>Registrar Nuevo Servicio</h2>
                <p>Ingresá los datos del tratamiento o servicio para agregarlo al catálogo.</p>
            </header>

            @if (TempData["Exito"] != null)
            {
                <div class="alert-exito">
                    @TempData["Exito"]
                </div>
            }
            <form asp-action="CreateService" asp-controller="Services" method="post" class="beauty-form">

                <div class="form-group">
                    <label for="nombre">Nombre del Servicio</label>
                    <input type="text" id="nombre" name="Nombre" placeholder="Ej: Corte Bob, Balayage, Manicuría Rusa..." required>
                </div>

                <div class="form-row">
                    <div class="form-group col">
                        <label for="precio">Precio ($)</label>
                        <input type="number" id="precio" name="Precio" min="0" step="0.01" placeholder="0.00" required>
                    </div>

                    <div class="form-group col">
                        <label for="duracion">Duración (minutos)</label>
                        <input type="number" id="duracion" name="Duracion" min="5" step="5" placeholder="Ej: 60" required>
                    </div>
                </div>             

                <div class="form-group">
                    <label for="descripcion">Descripción (Opcional)</label>
                    <textarea id="descripcion" name="Descripcion" rows="4" placeholder="Detalle del servicio, productos utilizados, etc..."></textarea>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-secondary">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Servicio</button>
                </div>

            </form>
        </section>
    </main>

</body>
</html>
