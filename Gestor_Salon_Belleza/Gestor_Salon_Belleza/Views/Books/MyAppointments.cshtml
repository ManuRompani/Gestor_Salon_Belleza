@model IEnumerable<Turno>
@{
    ViewData["Title"] = "Mis Turnos - Glow & Style";
}
@section Books {
    <link rel="stylesheet" href="~/css/books/my-appointments.css" asp-append-version="true" />
}

<div class="turnos-wrapper">
    <div class="turnos-hero">
        <h1>Mis turnos</h1>
        <p>Aquí podrás ver y administrar tus reservas</p>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="auth-success-alert" style="text-align:center;margin-bottom:2rem;">@TempData["Exito"]</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="appointments-list">
            @foreach (var turno in Model)
            {
                <div class="appointment-card @(turno.Estado ? "appointment-cancelled" : "")">
                    <div class="appointment-header">
                        <h3>
                            @turno.TurnoServicios?.FirstOrDefault()?.Servicio?.Nombre
                        </h3>
                        @if (turno.Estado)
                        {
                            <span class="appointment-badge badge-cancelled">Cancelada</span>
                        }
                        else if (turno.FechaHora > DateTime.Now)
                        {
                            <span class="appointment-badge badge-active">Activa</span>
                        }
                        else
                        {
                            <span class="appointment-badge badge-completed">Completada</span>
                        }
                    </div>
                    <div class="appointment-body">
                        <div class="appointment-info">
                            <span class="info-label">Profesional</span>
                            <span class="info-value">@turno.Profesional?.Usuario?.Nombre @turno.Profesional?.Usuario?.Apellido</span>
                        </div>
                        <div class="appointment-info">
                            <span class="info-label">Fecha y hora</span>
                            <span class="info-value">@turno.FechaHora.ToString("dddd, MMM dd, yyyy HH:mm")</span>
                        </div>
                        <div class="appointment-info">
                            <span class="info-label">Reservado el</span>
                            <span class="info-value">@turno.FechaCreacion.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>
                    @if (!turno.Estado && turno.FechaHora > DateTime.Now)
                    {
                        <div class="appointment-footer">
                            <form asp-action="Cancel" method="post" onsubmit="return confirm('¿Estás seguro de cancelar la cita?');">
                                <input type="hidden" name="id" value="@turno.Id_Turno" />
                                <button type="submit" class="btn btn-danger btn-sm">Cancelar cita</button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="turnos-empty">
            <p>No tenés turnos todavía.</p>
            <a asp-controller="Home" asp-action="Services" class="btn btn-primary">Reservá un turno</a>
        </div>
    }
</div>
