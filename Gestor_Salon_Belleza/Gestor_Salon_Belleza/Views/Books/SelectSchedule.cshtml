@using Gestor_Salon_Belleza.ViewModels
@model BookAppointmentViewModel
@{
    ViewData["Title"] = "Seleccionar horario - Glow & Style";
}
@section Styles {
    <link rel="stylesheet" href="~/css/books/select-schedule.css" asp-append-version="true" />
}

<div class="turnos-wrapper">
    <div class="turnos-hero">
        <span class="subtitle">Paso 2 de 3</span>
        <h1>Elegí fecha y hora</h1>
        <p>Profesional: <strong>@Model.ProfessionalName</strong> — Servicio: <strong>@Model.ServiceName</strong> (@Model.DurationMinutes min)</p>
    </div>

    <div class="schedule-actions">
        <a asp-action="SelectProfessional" asp-route-serviceId="@Model.ServiceId" class="btn btn-secondary">← Cambiar profesional</a>
        <a asp-controller="Home" asp-action="Services" class="btn btn-secondary">← Cambiar servicio</a>
        <a asp-controller="Home" asp-action="Index" class="cancel-link">Cancelar</a>
    </div>

    <div class="schedule-selector">
        <form method="get" asp-action="SelectSchedule" class="date-picker-form">
            <input type="hidden" name="serviceId" value="@Model.ServiceId" />
            <input type="hidden" name="professionalId" value="@Model.ProfessionalId" />
            <label for="date">Seleccioná una fecha</label>
            <input type="date" id="date" name="date"
                   value="@Model.PreferredDate?.ToString("yyyy-MM-dd")"
                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                   onchange="this.form.submit()" />
        </form>

        @if (Model.AvailableSlots != null && Model.AvailableSlots.Any())
        {
            <div class="slots-grid">
                @foreach (var slot in Model.AvailableSlots)
                {
                    @if (slot.Available)
                    {
                        <a asp-action="Confirm"
                           asp-route-serviceId="@Model.ServiceId"
                           asp-route-professionalId="@Model.ProfessionalId"
                           asp-route-dateTime='@slot.DateTime.ToString("yyyy-MM-ddTHH:mm:ss")'
                           class="slot-card slot-available">
                            @slot.Display
                        </a>
                    }
                    else
                    {
                        <div class="slot-card slot-occupied">
                            @slot.Display
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="turnos-empty">
                <p>No hay turnos disponibles para esta fecha.</p>
            </div>
        }
    </div>
</div>
