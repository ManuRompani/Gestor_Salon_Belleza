@model IEnumerable<Gestor_Salon_Belleza.ViewModels.ProfesionalListItemViewModel>

@{
    ViewData["Title"] = "Profesionales";
}

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/professional.css" asp-append-version="true" />

<section class="auth-container professional-shell">
    <div class="auth-card professional-index-card">
        <p class="auth-subtitle">GESTION INTERNA</p>
        <h2 class="auth-title">Profesionales</h2>
        <p class="professional-intro">
            Administra el equipo del salon, consulta sus datos principales y entra al detalle de cada perfil.
        </p>

        <div class="professional-top-actions">
            <a asp-controller="Profesional"
               asp-action="Create"
               class="btn-primary-custom professional-cta-link">
                Agregar profesional
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="professional-grid-list">
                @foreach (var profesional in Model)
                {
                    <article class="professional-summary-card">
                        <div class="professional-summary-copy">
                            <p class="professional-summary-label">Profesional</p>
                            <h3>@profesional.NombreCompleto</h3>
                            <p class="professional-summary-meta">@profesional.Email</p>
                            <p class="professional-summary-meta">@profesional.Telefono</p>
                            <p class="professional-summary-services">@profesional.Servicios</p>
                        </div>

                        <div class="professional-summary-actions">
                            <a asp-controller="Profesional"
                               asp-action="Details"
                               asp-route-id="@profesional.Id_Usuario"
                               class="btn-google professional-secondary-button">
                                Ver detalle
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="professional-empty-state">
                No hay profesionales cargados.
            </div>
        }

        <p class="auth-switch professional-back-link">
            <a asp-controller="Home" asp-action="Index">Volver al inicio</a>
        </p>
    </div>
</section>
