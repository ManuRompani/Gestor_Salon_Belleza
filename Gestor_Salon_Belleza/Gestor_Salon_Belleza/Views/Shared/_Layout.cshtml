<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>


    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />       

    <!-- MODULES ADMIN STYLES -->
    <link rel="stylesheet" href="~/css/admin/admin-professional.css" asp-append-version="true" />    
    

    @RenderSection("DashboardServices", required: false)
    @RenderSection("DashboardAdmin", required: false)
    @RenderSection("Books", required: false)
    @RenderSection("IndexServices", required: false)

    <style>
        .turnos-wrapper {
            flex: 1;
            padding: 56px 8% 70px;
        }
        .turnos-hero {
            text-align: center;
            max-width: 620px;
            margin: 0 auto 52px;
        }
        .turnos-hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3rem;
            font-weight: 700;
            color: #353654;
            line-height: 1.15;
            letter-spacing: -0.4px;
            margin: 0 auto 18px;
        }
        .turnos-hero p {
            font-size: 0.94rem;
            color: #6f6c77;
            line-height: 1.9;
            margin: 0 auto;
        }
        .turnos-hero .subtitle {
            display: block;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #b5838d;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .turnos-empty {
            text-align: center;
            padding: 4rem;
            color: #a29791;
            font-size: 0.94rem;
        }
        .cancel-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #c0392b;
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            padding: 8px 18px;
            border: 1.5px solid #e8c0c0;
            border-radius: 8px;
            transition: all 0.2s;
        }
        .cancel-link:hover {
            background: #fff5f5;
            border-color: #c0392b;
            box-shadow: 0 4px 12px rgba(192,57,43,0.12);
        }
        .cancel-link::before {
            content: "✕";
            font-size: 1rem;
            line-height: 1;
        }
        .cancel-row {
            text-align: center;
            margin-top: 40px;
        }
        @@media (max-width: 768px) {
            .turnos-wrapper { padding: 40px 5% 60px; }
            .turnos-hero h1 { font-size: 2.2rem; }
        }
    </style>




</head>
<body>
    <header class="header">
        <div class="logo">
            <a asp-controller="Home" asp-action="Index">Glow &amp; Style</a>
        </div>

        <input type="checkbox" id="menu-toggle" class="menu-checkbox">

        <label for="menu-toggle" class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </label>

        <nav class="nav-menu">
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li><a asp-controller="Home" asp-action="Services">Servicios</a></li>
                <li><a asp-controller="Home" asp-action="Specialists">Especialistas</a></li>
                <li>
                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Cliente"))
                    {
                        <a asp-controller="Books" asp-action="MyAppointments" class="btn-nav">Mis Turnos</a>
                    }
                </li>
                <li>
                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Cliente"))
                    {
                        <a asp-controller="Account" asp-action="Profile" class="btn-nav btn-profile">Mi Perfil</a>
                    }
                    else if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="RedirectByRol" class="btn-nav btn-profile">Mi Perfil</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn-nav btn-profile">Iniciar Sesión</a>
                    }
                </li>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn-nav btn-logout">Cerrar sesi&oacute;n</button>
                        </form>
                    </li>
                }
            </ul>
        </nav>
    </header>

    <main class="page-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-content">
            <p>&copy; 2026 Glow &amp; Style. Todos los derechos reservados.</p>
            <p>Buenos Aires, Argentina | Tel: +54 11 2345-6789</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
