<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-services.css" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    @RenderSection("DashboardServices", required: false)

</head>
<body>
    <header class="header">
        <div class="logo">
            <a asp-controller="Home" asp-action="Index">Glow &amp; Style</a>
        </div>

        <input type="checkbox" id="menu-toggle" class="menu-checkbox">

        <label for="menu-toggle" class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </label>

        <nav class="nav-menu">
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li><a asp-controller="Home" asp-action="Services">Servicios</a></li>
                <li><a asp-controller="Home" asp-action="Specialists">Especialistas</a></li>
                <li>                    
                        <a asp-controller="Account" asp-action="Login" class="btn-nav btn-profile">Mi Perfil</a>                   
                </li>
                @if (User.Identity.IsAuthenticated)
                {
                    <li>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn-nav btn-logout">Cerrar sesión</button>
                    </form>
                </li>
                
                }
                
            </ul>
        </nav>
    </header>

    @RenderBody()

    <footer class="footer">
        <div class="footer-content">
            <p>&copy; 2026 Glow &amp; Style. Todos los derechos reservados.</p>
            <p>Buenos Aires, Argentina | Tel: +54 11 2345-6789</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
